# ---------------------------------------------------------
# Central Server Backend Configuration (.env)
# ---------------------------------------------------------

PORT=8443
ENV=development

# --- PostgreSQL Database ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=attendance_app
DB_PASSWORD=changeme
DB_NAME=attendance
# Or full connection URI:
# DATABASE_URL=postgres://attendance_app:changeme@localhost:5432/attendance?sslmode=disable

# --- Security & Authentication ---
JWT_SECRET=changeme-generate-with-openssl-rand-hex-32
ADMIN_DEFAULT_PASSWORD=admin1234

# --- Storage ---
UPLOAD_DIR=data/enrollment_images
