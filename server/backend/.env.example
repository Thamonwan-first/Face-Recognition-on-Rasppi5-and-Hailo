# ---------------------------------------------------------
# Central Server Backend Configuration (.env)
# ---------------------------------------------------------

PORT=8443
LOG_LEVEL=info

# --- Database ---
# Development: sqlite
# Production:  postgres
DB_DIALECT=sqlite
SQLITE_PATH=./data/server.db

# PostgreSQL (when DB_DIALECT=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=attendance
DB_USER=attendance_app
DB_PASSWORD=changeme

# --- Authentication & JWT ---
JWT_SECRET=changeme-generate-with-openssl-rand-base64-48
JWT_EXPIRES_IN_MINUTES=480

# --- Enrollment Jobs ---
ENROLLMENT_IMAGE_DIR=./data/enrollment_images
ENROLLMENT_IMAGE_TTL_HOURS=24

# --- Device Management ---
DEVICE_OFFLINE_THRESHOLD_SECONDS=180
