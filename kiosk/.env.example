# ---------------------------------------------------------
# Kiosk Configuration — one file per device
# Copy this to .env and fill in real values
# ---------------------------------------------------------

# --- Device Identity ---
DEVICE_ID=kiosk-01
DEVICE_DIRECTION=AUTO
# Direction: IN | OUT | AUTO
# IN/OUT = fixed direction (separate entry/exit gates)
# AUTO   = user picks on touchscreen or toggle

# --- Server Connection ---
SERVER_URL=https://192.168.1.100:8443
API_KEY=changeme-generate-with-openssl-rand-hex-32

# --- Face Recognition ---
RECOGNITION_THRESHOLD=0.55
DEBOUNCE_SECONDS=30
MAX_ENROLL_IMAGES=5
MIN_ENROLL_IMAGES=3

# --- Model Paths (relative to kiosk/models/) ---
DETECT_MODEL=scrfd_2.5g.hef
EMBEDDING_MODEL=arcface_mobilefacenet.hef

# --- Camera ---
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30

# --- Sync ---
SYNC_INTERVAL_SECONDS=10
SYNC_BATCH_SIZE=50
USER_SYNC_INTERVAL_SECONDS=30
HEARTBEAT_INTERVAL_SECONDS=60

# --- Database ---
DB_PATH=data/kiosk.db

# --- UI ---
FULLSCREEN=true
DISPLAY_WIDTH=800
DISPLAY_HEIGHT=480

# --- Clock ---
# Set to false if no RTC module (DS3231) is installed
HAS_RTC=false
