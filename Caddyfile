# Caddyfile — internal HTTPS reverse proxy
# Replace attendance.local with the org's internal hostname or IP.

# Caddyfile — HTTP & HTTPS reverse proxy for local network IP and domain

# 1. Plain HTTP for direct local IP access from phones and browsers (No SSL warnings / No redirect loops)
http://:80 {
    # API proxy
    handle /api/* {
        reverse_proxy server:8443
    }
    handle /auth/* {
        reverse_proxy server:8443
    }
    handle /sync/* {
        reverse_proxy server:8443
    }
    handle /health {
        reverse_proxy server:8443
    }

    # Dashboard SPA (Static files & HTML5 routing)
    handle {
        root * /srv/dashboard
        try_files {path} /index.html
        file_server
    }
}

# 2. HTTPS with internal self-signed TLS (Optional)
https://:443, https://attendance.local {
    tls internal

    # API proxy
    handle /api/* {
        reverse_proxy server:8443
    }
    handle /auth/* {
        reverse_proxy server:8443
    }
    handle /sync/* {
        reverse_proxy server:8443
    }
    handle /health {
        reverse_proxy server:8443
    }

    # Dashboard SPA
    handle {
        root * /srv/dashboard
        try_files {path} /index.html
        file_server
    }
}
