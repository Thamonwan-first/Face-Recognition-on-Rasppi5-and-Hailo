# Caddyfile — internal HTTPS reverse proxy
# Replace attendance.local with the org's internal hostname or IP.

attendance.local {
    # TLS with internal/self-signed CA
    tls internal

    # API proxy
    handle /api/* {
        reverse_proxy server:8443
    }
    handle /auth/* {
        reverse_proxy server:8443
    }
    handle /sync/* {
        reverse_proxy server:8443
    }
    handle /health {
        reverse_proxy server:8443
    }

    # Redirect legacy /dashboard path to root
    handle /dashboard* {
        redir * / 308
    }

    # Dashboard SPA
    handle /* {
        root * /srv/dashboard
        file_server
        try_files {path} /index.html
    }
}
